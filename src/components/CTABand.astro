<style>
  .cta-band { background:var(--color-ink); padding:96px 24px; text-align:center; }
  .cta-tag { display:inline-flex; align-items:center; gap:6px; background:rgba(159,232,112,.15); color:var(--color-primary); font-size:12px; font-weight:600; padding:4px 12px; border-radius:var(--radius-pill); margin-bottom:24px; }
  .cta-h2 { font-size:52px; font-weight:900; letter-spacing:-2px; color:var(--color-canvas); line-height:1.05; max-width:640px; margin:0 auto 14px; }
  .cta-h2 em { font-style:normal; color:var(--color-primary); }
  .cta-sub { font-size:17px; color:rgba(255,255,255,.55); margin:0 auto 36px; max-width:440px; }
  .cta-actions { display:flex; align-items:center; justify-content:center; gap:12px; flex-wrap:wrap; }
  .btn-cta { background:var(--color-primary); color:var(--color-on-primary); font-size:16px; font-weight:600; padding:16px 32px; border-radius:var(--radius-xl); text-decoration:none; transition:background .15s; }
  .btn-cta:hover { background:var(--color-primary-active); }
  .btn-cta-ghost { background:rgba(255,255,255,.1); color:var(--color-canvas); border:1.5px solid rgba(255,255,255,.2); }
  .btn-cta-ghost:hover { background:rgba(255,255,255,.16); }
  .cta-note { margin-top:16px; font-size:13px; color:rgba(255,255,255,.35); }
  @media (max-width:767px) { .cta-h2 { font-size:32px; letter-spacing:-1px; } }
</style>

<section class="cta-band" id="konsultasi">
  <div class="cta-tag"><span>✦</span> Konsultasi gratis 30 menit</div>
  <h2 class="cta-h2">Siap setup <em>PT Anda</em>?</h2>
  <p class="cta-sub">Tidak ada commitment. Diskusi dulu soal struktur, nama, dan timeline — gratis.</p>
  <div class="cta-actions">
    <a href="https://wa.me/628000000000" class="btn-cta">💬 Chat WhatsApp Sekarang</a>
    <a href="mailto:hello@legalize.id" class="btn-cta btn-cta-ghost">Kirim Email</a>
  </div>
  <p class="cta-note">Response rata-rata &lt;2 jam · Sen–Jum 09.00–18.00 WIB</p>
</section>
